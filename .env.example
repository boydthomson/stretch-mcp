# Momence (studio booking system), public API v2 OAuth client
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
MOMENCE_HOST_ID=

# Front desk shifts: any iCal feed (Rippling, When I Work, Google Calendar)
