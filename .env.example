# Human approval for writes. Leave blank and every write stays a dry run.
MATRIX_HOMESERVER=
MATRIX_ACCESS_TOKEN=
APPROVAL_ROOM_ID=
APPROVER_USER_IDS=@owner:example.org

STUDIO_TZ=America/Vancouver
STRETCH_MCP_STATE_DIR=
